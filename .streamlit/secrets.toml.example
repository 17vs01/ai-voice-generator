# Streamlit Cloud 배포용 Secrets 예시
# ─────────────────────────────────────────────────────────────
# 로컬에서는 .env 파일을 쓰세요. 이 파일은 "클라우드 배포" 전용 안내예요.
#
# Streamlit Community Cloud 에 배포할 때:
#   App 우측 하단 ⋮ → Settings → Secrets 에 아래 내용을 붙여넣으세요.
#   (여기 .example 파일이 아니라, 클라우드의 Secrets 입력창에!)
#
# 로컬에서 secrets.toml 로 테스트하고 싶다면 이 파일을
#   .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요.
#   (secrets.toml 은 .gitignore 에 있어 깃에 안 올라갑니다.)

# ElevenLabs (자연스러운 목소리 + STT + 자막). 없으면 Google TTS 로 동작.
ELEVENLABS_API_KEY = "sk_여기에_실제_키"

# OpenAI (OpenAI 목소리 + AI 교정/요약/번역). 선택.
OPENAI_API_KEY = "sk-여기에_실제_키"

# 공개 배포 시 크레딧 보호용 비밀번호. 설정하면 접속 시 비밀번호를 물어봐요.
# 비워두거나 지우면 잠금 없이 누구나 접속 가능(주의!).
APP_PASSWORD = "원하는_비밀번호"
